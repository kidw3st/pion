# Логи и конфиг недоступны снаружи; работают только PHP-точки входа.
<FilesMatch "\.(log|json|example\.php)$">
  Require all denied
</FilesMatch>
<Files "config.php">
  Require all denied
</Files>
<Files "lib.php">
  Require all denied
</Files>
<Files "posiflora.php">
  Require all denied
</Files>
<Files "sync-showcase.php">
  Require all denied
</Files>

# Счётчики частоты обращений — служебные файлы, наружу не отдаём.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^rate/ - [F,L]
</IfModule>
