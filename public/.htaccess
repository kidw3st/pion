# Апач хостинга: наши страницы — статический экспорт Next.js.

# Несуществующий адрес получает нашу страницу 404, а не серверную заглушку.
ErrorDocument 404 /404.html

# index.php важнее index.html. Блог будет работать на WordPress в папке
# /blog, а там сейчас лежит наша временная страница: как только появится
# index.php, WordPress перекроет её сам, и очередное обновление сайта его
# не затрёт.
DirectoryIndex index.php index.html

# Список файлов в папке наружу не отдаём: иначе каталог с фотографиями
# можно скачать целиком, просто открыв /images/catalog/bukety/.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Старые адреса Tilda ------------------------------------------------
  # До переезда на Next.js товары жили по адресам вида
  #   /bukety/tproduct/280188558-553645466981-buket-barhatnye-grani
  # Яндекс до сих пор держит их в индексе и приводит на них людей, а сервер
  # отвечал 404: и посетитель терялся, и накопленный вес страницы пропадал.
  #
  # Средняя цифра в адресе — это uid товара, он же в наших данных, а часть
  # после неё — тот же slug, что у новой страницы. Поэтому адрес переводится
  # правилом, без списка на пятьсот строк.

  # Есть страница этого товара — ведём точно на неё.
  RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html -f
  RewriteRule ^([a-z0-9_-]+)/tproduct/[0-9]+-[0-9]+-([^/?]+)/?$ /$1/$2/ [R=301,L]

  # Товар не нашёлся (переименовали, сняли с продажи) — в его раздел,
  # это ближе к тому, что человек искал, чем страница ошибки.
  RewriteRule ^([a-z0-9_-]+)/tproduct/ /$1/ [R=301,L]

  # Адрес без раздела — в общий каталог.
  RewriteRule ^tproduct/ /catalog/ [R=301,L]

  # Служебные адреса магазина Tilda индексировать было незачем.
  RewriteRule ^([a-z0-9_-]+/)?tstore/ /catalog/ [R=301,L]

  # --- Защита от парсеров -------------------------------------------------
  # Платёжные точки исключены из всех правил ниже: туда стучится банк и наш
  # же сервер, и их «агенты» выглядят как роботы.
  #
  # Блокируем сборщиков баз и SEO-краулеров, которые выкачивают каталог
  # целиком и создают нагрузку, но покупателей не приводят. Поисковики
  # (Яндекс, Google, Bing, Mail.ru) и ИИ-боты (GPTBot, ClaudeBot,
  # PerplexityBot, YandexGPT) в список НЕ входят — они нам нужны.
  RewriteCond %{REQUEST_URI} !^/pay/ [NC]
  RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|mj12bot|dotbot|blexbot|dataforseo|serpstat|megaindex|zoominfo|barkrowler|seekport|linkfluence|magpie-crawler|netestate|sitebulb|screaming\ frog|sistrix|spbot|seokicks|backlink|domcop|webmeup|riddler|purebot) [NC]
  RewriteRule .* - [F,L]

  # Инструменты массового скачивания сайтов и «голые» скрипты.
  RewriteCond %{REQUEST_URI} !^/pay/ [NC]
  RewriteCond %{HTTP_USER_AGENT} (httrack|webcopier|webzip|teleport|offline\ explorer|sitesnagger|website\ extractor|wget|libwww|lwp-trivial|larbin|xenu|scrapy|node-fetch|go-http-client|python-urllib|python-requests|okhttp|java/|jakarta|apache-httpclient) [NC]
  RewriteRule .* - [F,L]

  # Запрос совсем без User-Agent — почти всегда самописный парсер.
  RewriteCond %{REQUEST_URI} !^/pay/ [NC]
  RewriteCond %{HTTP_USER_AGENT} ^$
  RewriteRule .* - [F,L]

  # --- Чужие сайты не показывают наши фотографии со своих страниц ---------
  # Пустой Referer разрешён (прямое открытие картинки, часть браузеров),
  # как и переходы из поиска и мессенджеров — иначе пропадут превью.
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?pionperm\.ru [NC]
  RewriteCond %{HTTP_REFERER} !(google|yandex|bing|duckduckgo|mail\.ru|vk\.com|t\.me|telegram|whatsapp|instagram|facebook) [NC]
  RewriteRule \.(jpe?g|png|webp|gif|svg)$ - [F,NC,L]
</IfModule>

# Фото и статика неизменяемы (имена файлов версионированы) — кэшируем надолго.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Сжатие текстовых ответов.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Заголовки безопасности, которые нельзя задать из статической страницы.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Сайт целиком на https (сертификат Let's Encrypt обновляется сам), поэтому
  # просим браузер год не ходить по http вообще. Без includeSubDomains и без
  # preload: это отменяется только временем, а поддоменов у домена нет — рисковать
  # чужими именами незачем.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
